<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oceania TV Mini App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        /* 2. Use Telegram CSS Variables for "Native" look */
        body {
            background-color: var(--tg-theme-bg-color, #ffffff);
            color: var(--tg-theme-text-color, #000000);
            font-family: sans-serif;
            margin: 0;
            padding: 10px;
        }
        .card {
            background: var(--tg-theme-secondary-bg-color, #f0f0f0);
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            cursor: pointer;
            position: relative;
        }
        .badge {
            background: var(--tg-theme-button-color, #2481cc);
            color: var(--tg-theme-button-text-color, #ffffff);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            position: absolute;
            top: 5px;
            right: 5px;
        }
        #player-container {
            display: none;
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--tg-theme-bg-color);
            padding-bottom: 10px;
        }
        iframe {
            width: 100%;
            height: 200px;
            border: none;
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <div id="player-container">
        <h3 id="p-title">Watching:</h3>
        <iframe id="main-ifr" allowfullscreen></iframe>
    </div>

    <div id="status-text">Connecting to Telegram...</div>
    <div id="loader">Loading channels...</div>
    <div id="channel-grid"></div>

    <script>
        // Initialize Telegram WebApp
        const tg = window.Telegram.WebApp;
        tg.ready(); // Notify Telegram that the app is ready
        tg.expand(); // Expand to full height

        const PROXY = "YOUR_PROXY_URL_HERE"; // Ensure your proxy is set
        const API_URL = "YOUR_API_URL_HERE";
        
        const loader = document.getElementById('loader');
        const statusText = document.getElementById('status-text');

        async function fetchChannels() {
            try {
                const response = await fetch(PROXY + encodeURIComponent(API_URL));
                if (!response.ok) throw new Error("CORS Proxy Failure");
                
                const data = await response.json();
                
                const oceaniaChannels = (data.channels || []).filter(ch => {
                    const code = ch.code ? ch.code.toLowerCase() : '';
                    return code === 'au' || code === 'nz';
                });

                loader.style.display = 'none';
                statusText.innerText = `Online: ${oceaniaChannels.length} Channels found`;
                
                renderGrid(oceaniaChannels);
            } catch (err) {
                loader.innerText = "Error loading channels.";
                statusText.innerText = "Connection Failed";
                tg.showAlert("Failed to fetch channels. Please check your connection.");
            }
        }

        function renderGrid(channels) {
            const grid = document.getElementById('channel-grid');
            grid.innerHTML = '';

            if (channels.length === 0) {
                grid.innerHTML = '<p>No channels active for AU/NZ.</p>';
                return;
            }

            channels.forEach(ch => {
                if (!ch.url || ch.url === "null") return;

                const card = document.createElement('div');
                card.className = 'card';

                card.innerHTML = `
                    <span class="badge">${ch.code.toUpperCase()}</span>
                    <img src="${(ch.image && ch.image.startsWith('http')) ? ch.image : 'https://via.placeholder.com/60?text=TV'}" width="60" loading="lazy">
                    <p>${ch.name}</p>
                `;

                card.onclick = () => {
                    const container = document.getElementById('player-container');
                    const iframe = document.getElementById('main-ifr');
                    const title = document.getElementById('p-title');

                    title.textContent = `Watching: ${ch.name}`;
                    iframe.src = ch.url;
                    container.style.display = 'block';
                    
                    // Show Telegram Back Button when watching
                    tg.BackButton.show();
                    tg.BackButton.onClick(() => {
                        container.style.display = 'none';
                        iframe.src = "";
                        tg.BackButton.hide();
                    });

                    // Haptic feedback for the click
                    tg.HapticFeedback.impactOccurred('light');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                };

                grid.appendChild(card);
            });
        }

        fetchChannels();
    </script>
</body>
</html>
